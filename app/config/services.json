{
    "compose": {
        "file": "podman-compose.yaml"
    },
    "services": [
        {
            "name": "redis",
            "type": "docker",
            "enabled": true,
            "runtime": "podman",
            "container_name": "redis",
            "check": "tcp",
            "host": "127.0.0.1",
            "port": 6379
        },
        {
            "name": "whisper",
            "type": "docker",
            "enabled": true,
            "runtime": "podman",
            "container_name": "whisper",
            "check": "http",
            "url": "http://127.0.0.1:10023/v1/models",
            "expected_status": 200,
            "timeout": 10
        },
        {
            "name": "kokoro-tts",
            "type": "docker",
            "enabled": true,
            "runtime": "podman",
