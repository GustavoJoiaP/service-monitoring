{
    "services": [

        {
            "type": "heartbeat",
            "enabled": true
        },

        {
            "type": "counter",
            "enabled": true
        },

        {
            "type": "worker",
            "enabled": true,
            "name": "Producer",
            "command": [
                "python3",
                "app/workers/producer_worker.py"
            ]
        },

        {
            "type": "worker",
            "enabled": true,
            "name": "Consumer",
            "command": [
                "python3",
                "app/workers/consumer_worker.py"
            ]
        }
    ]
}