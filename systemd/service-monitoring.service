[Unit]
Description=Service Monitoring Host
After=network-online.target docker.service podman.socket
Wants=docker.service podman.socket

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/service-monitoring

Environment=PYTHONUNBUFFERED=1

ExecStartPre=/bin/sh -c 'until podman info >/dev/null 2>&1 || docker info >/dev/null 2>&1; do sleep 1; done'

ExecStart=/opt/service-monitoring/.venv/bin/python -m app.main

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
